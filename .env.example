APP_NAME=Sikitaya
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sikitaya
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="halo@sikitaya.test"
MAIL_FROM_NAME="${APP_NAME}"

RAJAONGKIR_MODE=dummy
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter
RAJAONGKIR_ORIGIN_CITY_ID=278
RAJAONGKIR_TIMEOUT=15

MIDTRANS_ENABLED=true
# Kode Midtrans disimpan, tetapi checkout transfer/QRIS simulasi dan COD yang aktif.
MIDTRANS_CHECKOUT_ENABLED=false
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_PRODUCTION_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PLATFORM_MERCHANT_ID=
MIDTRANS_NOTIFICATION_URL=
MIDTRANS_EXPIRY_MINUTES=1440
MIDTRANS_SPLIT_ENABLED=false
MIDTRANS_DISBURSEMENT_ENABLED=false
MIDTRANS_IRIS_BASE_URL=
MIDTRANS_IRIS_CREATOR_KEY=
MIDTRANS_IRIS_APPROVER_KEY=
MIDTRANS_IRIS_AUTO_APPROVE=true
MIDTRANS_IRIS_DEFAULT_EMAIL=
MIDTRANS_IRIS_TIMEOUT=30

VITE_APP_NAME="${APP_NAME}"
